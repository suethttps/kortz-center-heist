<%#
  VIEW: Planning Board (index)
  HTML + ERB. Tags com = imprimem; tags sem = só executam (loops/ifs).
  Cuidado: dentro de comentario ERB NAO pode aparecer a sequencia que fecha a tag,
  senao o comentario "vaza" pro HTML do browser.
  Dados (@primary_targets, etc.) vem do controller.
%>

<% content_for :title, "Kortz Center — Planning Board" %>

<section class="planning-board" aria-label="Quadro de planejamento do Kortz Center Heist">
  <%# Barbante decorativo — só estética, como no board do jogo %>
  <div class="board-string" style="top: 22%; left: 18%; width: 38%; transform: rotate(8deg);"></div>
  <div class="board-string" style="top: 48%; left: 42%; width: 28%; transform: rotate(-12deg);"></div>

  <header class="board-header">
    <p class="board-header__sub">Art Studio · Los Santos</p>
    <h1 class="board-header__brand">KORTZ CENTER</h1>
    <p class="board-header__sub">Heist Planning Board</p>
    <span class="board-header__stamp">Classified · Crew Only</span>
  </header>

  <div class="board-grid">
    <%# ===================== COLUNA ESQUERDA ===================== %>
    <div class="stack">
      <%#
        --- PRIMARY TARGET CAROUSEL ---
        Um polaroid com setas: troca imagem + nome + preços do alvo.
        Stimulus controller: carousel_controller.js
      %>
      <article
        class="paper-card polaroid"
        style="transform: rotate(<%= pin_tilt(0) %>); animation-delay: 0.05s;"
        data-controller="carousel"
        aria-roledescription="carousel"
        aria-label="Alvos primários do heist"
      >
        <span class="paper-card__pin paper-card__pin--gold" aria-hidden="true"></span>
        <h2>Primary Target</h2>

        <% if @primary_targets.any? %>
          <%# Toggles globais do carrossel: Easy/Hard, First/Repeat, Alarm %>
          <div class="payout-toggles">
            <div class="payout-toggles__group" role="group" aria-label="Dificuldade">
              <button type="button" class="payout-toggle is-active" data-toggle-group="difficulty" data-difficulty="easy" data-action="carousel#setDifficulty">Easy</button>
              <button type="button" class="payout-toggle" data-toggle-group="difficulty" data-difficulty="hard" data-action="carousel#setDifficulty">Hard</button>
            </div>
            <div class="payout-toggles__group" role="group" aria-label="Tipo de run">
              <button type="button" class="payout-toggle is-active" data-toggle-group="run" data-run="first" data-action="carousel#setRun">1ª semana</button>
              <button type="button" class="payout-toggle" data-toggle-group="run" data-run="repeat" data-action="carousel#setRun">Repeat</button>
            </div>
            <div class="payout-toggles__group" role="group" aria-label="Alarme">
              <button type="button" class="payout-toggle is-active" data-toggle-group="alarm" data-alarm="false" data-action="carousel#setAlarm">No alarm</button>
              <button type="button" class="payout-toggle" data-toggle-group="alarm" data-alarm="true" data-action="carousel#setAlarm">Alarm</button>
            </div>
          </div>

          <div class="carousel">
            <% @primary_targets.each_with_index do |target, index| %>
              <div
                class="carousel__slide<%= " is-active" if index.zero? %>"
                data-carousel-target="slide"
                data-payout-easy-first-no-alarm="<%= target.easy_first_no_alarm %>"
                data-payout-easy-first-alarm="<%= target.easy_first_alarm %>"
                data-payout-easy-repeat-no-alarm="<%= target.easy_repeat %>"
                data-payout-easy-repeat-alarm="<%= target.easy_repeat_alarm %>"
                data-payout-hard-first-no-alarm="<%= target.hard_first_no_alarm %>"
                data-payout-hard-first-alarm="<%= target.hard_first_alarm %>"
                data-payout-hard-repeat-no-alarm="<%= target.hard_repeat %>"
                data-payout-hard-repeat-alarm="<%= target.hard_repeat_alarm %>"
                <%= "hidden" unless index.zero? %>
              >
                <div class="polaroid__frame">
                  <% if target.image_available? %>
                    <%= image_tag target.image_path, alt: target.name, class: "polaroid__image" %>
                  <% else %>
                    <span class="polaroid__glyph">ART</span>
                  <% end %>
                </div>

                <p class="polaroid__caption"><%= target.name %></p>
                <p class="polaroid__price" data-carousel-target="heroPrice">
                  <%= gta_money(target.easy_first_no_alarm) %>
                </p>
                <p class="polaroid__mode" data-carousel-target="modeLabel">
                  Easy · 1ª da semana · No alarm
                </p>
                <p style="font-size: 0.72rem; color: var(--ink-faded); margin: 0.2rem 0 0;">
                  Reset <%= @economy[:weekly_reset] %> · imagem depois se quiser
                </p>

                <%# Tabela completa Easy / Hard %>
                <table class="payout-table">
                  <thead>
                    <tr>
                      <th></th>
                      <th colspan="2">Easy</th>
                      <th colspan="2">Hard</th>
                    </tr>
                    <tr>
                      <th></th>
                      <th>No alarm</th>
                      <th>Alarm</th>
                      <th>No alarm</th>
                      <th>Alarm</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <th scope="row">1ª semana</th>
                      <td data-payout-cell="easy_first_no_alarm" class="is-highlight"><%= gta_money_short(target.easy_first_no_alarm) %></td>
                      <td data-payout-cell="easy_first_alarm"><%= gta_money_short(target.easy_first_alarm) %></td>
                      <td data-payout-cell="hard_first_no_alarm"><%= gta_money_short(target.hard_first_no_alarm) %></td>
                      <td data-payout-cell="hard_first_alarm"><%= gta_money_short(target.hard_first_alarm) %></td>
                    </tr>
                    <tr>
                      <th scope="row">Repeat</th>
                      <td data-payout-cell="easy_repeat_no_alarm"><%= gta_money_short(target.easy_repeat) %></td>
                      <td data-payout-cell="easy_repeat_alarm"><%= gta_money_short(target.easy_repeat_alarm) %></td>
                      <td data-payout-cell="hard_repeat_no_alarm"><%= gta_money_short(target.hard_repeat) %></td>
                      <td data-payout-cell="hard_repeat_alarm"><%= gta_money_short(target.hard_repeat_alarm) %></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            <% end %>

            <div class="carousel__controls">
              <button type="button" class="carousel__btn" data-action="carousel#prev" aria-label="Alvo anterior">‹</button>

              <label class="carousel__jump">
                <span class="visually-hidden">Ir para alvo</span>
                <select data-action="change->carousel#goTo" aria-label="Escolher pintura">
                  <% @primary_targets.each_with_index do |target, index| %>
                    <option value="<%= index %>" data-carousel-index="<%= index %>" <%= "selected" if index.zero? %>>
                      <%= index + 1 %>. <%= target.name %>
                    </option>
                  <% end %>
                </select>
              </label>

              <span class="carousel__counter" data-carousel-target="counter">
                1 / <%= @primary_targets.size %>
              </span>

              <button type="button" class="carousel__btn" data-action="carousel#next" aria-label="Próximo alvo">›</button>
            </div>
          </div>
        <% else %>
          <p class="polaroid__caption">Sem dados — rode <code>bin/rails db:seed</code></p>
        <% end %>
      </article>

      <%#
        --- SECONDARY LOOT + BOLSA ---
        Clique pra selecionar até 100% da bolsa; total embaixo.
        Stimulus: bag_controller.js
      %>
      <article
        class="paper-card"
        style="transform: rotate(<%= pin_tilt(2) %>); animation-delay: 0.18s;"
        data-controller="bag"
        data-bag-capacity-value="100"
      >
        <span class="paper-card__pin" aria-hidden="true"></span>
        <h3>Secondary Targets</h3>
        <p style="margin: 0 0 0.5rem;">
          Pool no prédio ~<%= gta_money_short(2_300_000) %>–<%= gta_money_short(2_677_500) %>.
          Monte a bolsa solo (máx. 100%).
        </p>

        <ul class="loot-list loot-list--selectable" role="listbox" aria-label="Secondary targets da bolsa" aria-multiselectable="true">
          <% @secondary_targets.each do |loot| %>
            <li>
              <button
                type="button"
                class="loot-item"
                data-bag-target="item"
                data-bag-weight-value="<%= loot.bag_weight.to_i %>"
                data-bag-price-value="<%= loot.first_weekly_payout.to_i %>"
                data-action="bag#toggle"
                aria-pressed="false"
              >
                <span class="loot-list__name"><%= loot.name %></span>
                <span class="loot-list__price"><%= gta_money(loot.first_weekly_payout) %></span>
                <span class="loot-list__meta">
                  <%= loot.location %>
                  <% if loot.bag_weight.to_i > 0 %>
                    · bolsa ~<%= loot.bag_weight %>%
                  <% end %>
                </span>
              </button>
            </li>
          <% end %>
        </ul>

        <div class="bag-summary">
          <div class="bag-summary__bar" aria-hidden="true">
            <div class="bag-summary__fill" data-bag-target="fill"></div>
          </div>

          <div class="bag-summary__row">
            <span>Bolsa</span>
            <strong data-bag-target="used">0% / 100%</strong>
          </div>
          <div class="bag-summary__row">
            <span>Itens secondary</span>
            <strong data-bag-target="count">0</strong>
          </div>
          <div class="bag-summary__row">
            <span>Primary · <em data-bag-target="primaryName">—</em></span>
            <strong data-bag-target="primaryTotal">GTA$0</strong>
          </div>
          <div class="bag-summary__row">
            <span>Secondary (bolsa)</span>
            <strong data-bag-target="total">GTA$0</strong>
          </div>

          <%# Bônus — valor muda com Easy ($50k) / Hard ($100k) do primary %>
          <div class="bag-bonuses">
            <button
              type="button"
              class="bag-bonus"
              data-bonus="buyer"
              data-action="bag#toggleBuyer"
              aria-pressed="false"
            >
              <span class="bag-bonus__check" aria-hidden="true"></span>
              <span class="bag-bonus__text">
                <span data-bag-target="buyerLabel">Buyer’s Request (Easy)</span>
                <small>$50K Easy · $100K Hard</small>
              </span>
              <strong data-bag-target="buyerBonus">GTA$50,000</strong>
            </button>

            <button
              type="button"
              class="bag-bonus"
              data-bonus="elite"
              data-action="bag#toggleElite"
              aria-pressed="false"
            >
              <span class="bag-bonus__check" aria-hidden="true"></span>
              <span class="bag-bonus__text">
                <span data-bag-target="eliteLabel">Elite Challenge (Easy)</span>
                <small>$50K Easy · $100K Hard</small>
              </span>
              <strong data-bag-target="eliteBonus">GTA$50,000</strong>
            </button>
          </div>

          <div class="bag-summary__row bag-summary__row--total">
            <span>Total da run</span>
            <strong data-bag-target="grandTotal">GTA$0</strong>
          </div>

          <p class="bag-summary__hint" data-bag-target="hint">
            Clique nos itens pra somar com o Primary Target.
          </p>

          <button type="button" class="bag-summary__clear" data-action="bag#clear">
            Limpar bolsa
          </button>
        </div>
      </article>
    </div>

    <%# ===================== COLUNA DIREITA ===================== %>
    <div class="stack">
      <%# --- POST-IT DE ECONOMIA --- %>
      <aside class="postit" style="animation-delay: 0.1s;">
        <h3>Money Notes</h3>
        <ul style="margin: 0; padding-left: 1.1rem;">
          <li>
            Main Targets no board:
            <strong><%= @economy[:primary_count] %></strong>
            (Easy/Hard × alarm)
          </li>
          <li>
            Top Easy 1ª / no alarm:
            <strong><%= gta_money(@economy[:main_first]) %></strong>
            (<%= @economy[:main_target_name] %>)
          </li>
          <li>
            Solo 1ª run:
            <strong><%= gta_money_short(@economy[:solo_first_min]) %>–<%= gta_money_short(@economy[:solo_first_max]) %></strong>
          </li>
          <li>
            Crew 4 (máx. reportado):
            <strong><%= gta_money(@economy[:crew_max_reported]) %></strong>
          </li>
          <li>
            Setup fee: grátis 1ª /
            <strong><%= gta_money(@economy[:setup_fee_repeat]) %></strong> repeat
          </li>
          <li>
            Buyer’s Request: <%= gta_money_short(@economy[:buyer_request_normal]) %> Normal /
            <%= gta_money_short(@economy[:buyer_request_hard]) %> Hard
          </li>
          <li>
            Elite Challenge: <%= gta_money_short(@economy[:elite_challenge_normal]) %> /
            <%= gta_money_short(@economy[:elite_challenge_hard]) %> Hard
          </li>
          <li>Reset semanal: <strong><%= @economy[:weekly_reset] %></strong></li>
        </ul>
        <p style="margin: 0.75rem 0 0; font-size: 0.78rem;">
          Conselho da crew: faça <strong>uma run limpa por semana</strong>.
          Repeat com fee de $100k quase não vale o tempo.
        </p>
      </aside>

      <%# --- ENTRY POINTS --- %>
      <article class="paper-card" style="transform: rotate(<%= pin_tilt(3) %>); animation-delay: 0.2s;">
        <span class="paper-card__pin" aria-hidden="true"></span>
        <h3>Entry Points</h3>
        <p style="margin-top: 0;">Fotografar no Scope Out. Infiltration Gear = porta da finale.</p>
        <div class="entry-grid">
          <% @entry_points.each do |entry| %>
            <div class="entry-chip">
              <strong><%= entry.name %></strong>
              <%= entry.gear_option %><br>
              <span style="opacity: 0.8;"><%= entry.description %></span>
              <% if entry.guide? %>
                <%= link_to "▶ Guide (YouTube)", entry.guide_url,
                      class: "entry-chip__guide",
                      target: "_blank",
                      rel: "noopener noreferrer" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </article>

      <%# --- PREPS OBRIGATÓRIAS --- %>
      <article class="paper-card" style="transform: rotate(<%= pin_tilt(4) %>); animation-delay: 0.26s;">
        <span class="paper-card__pin" aria-hidden="true"></span>
        <h3>Mandatory Preps</h3>
        <ul class="prep-list">
          <% @mandatory_preps.each do |prep| %>
            <li>
              <span class="prep-check" aria-hidden="true"></span>
              <div>
                <span class="prep-list__title"><%= prep.name %></span>
                <span class="prep-list__hint">
                  <%= prep.category_label %> — <%= prep.description %>
                </span>
              </div>
            </li>
          <% end %>
        </ul>
      </article>

      <%# --- PREPS OPCIONAIS --- %>
      <article class="paper-card" style="transform: rotate(<%= pin_tilt(5) %>); animation-delay: 0.32s;">
        <span class="paper-card__pin" aria-hidden="true"></span>
        <h3>Optional Preps</h3>
        <p style="margin-top: 0;">Desbloqueadas no Scope Out (foto / CCTV).</p>
        <ul class="prep-list">
          <% @optional_preps.each do |prep| %>
            <li>
              <span class="prep-check prep-check--optional" aria-hidden="true"></span>
              <div>
                <span class="prep-list__title"><%= prep.name %></span>
                <span class="prep-list__hint">
                  <%= prep.description %><br>
                  Unlock: <%= prep.unlock_hint %>
                </span>
              </div>
            </li>
          <% end %>
        </ul>
      </article>
    </div>
  </div>

  <footer class="board-footer">
    Projeto de estudo Rails · guia pra amigos da crew ·
    valores da comunidade (jul/2026) — confirme in-game após patches
  </footer>
</section>
